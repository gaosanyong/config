# user-defined aliases (sourced by .bashrc)

# --- Modern CLI Drop-in Replacements ---
if command -v bat &> /dev/null; then
  alias cat='bat --paging=never'
elif command -v batcat &> /dev/null; then
  alias cat='batcat --paging=never' # ubuntu renames bat to batcat
fi

if command -v zoxide &> /dev/null; then
  alias cd='z'
fi

if command -v rg &> /dev/null; then 
  alias grep='rg'
fi

if command -v eza &> /dev/null; then 
  alias ls='eza --icons=auto --group-directories-first'
  alias ll='eza -la --icon=auto --group-directories-first'
  alias l.='eza -d .* --icons=auto'
else 
  alias ls='ls --color=auto'
  alias ll='ls -la'
  alias l.='ls -d .*'
fi

# --- Safer & Smarter Defaults ---
alias ..='cd ..'
alias ...='cd ../..'
alias bc='bc -l'
alias mkdir='mkdir -pv'
alias ping='ping -c 5'
alias wget='wget -c'

# --- Helpers & Shortcuts ---
alias h='history | less'
alias untar='tar -xvf' # modern tar auto-detects compression (.gz, .bz2, .xz)
alias path='echo -e ${PATH//:/\\n}'
alias now='date +"%T"'
alias today='date +"%Y-%m-%d"'

# --- Work / Meta specific ---
command -v jf &> /dev/null && alias jfd='jf submit --draft'
command -v x2ssh &> /dev/null && alias ssh='x2ssh -et'
command -v taste-tester &> /dev/null && alias tt='taste-tester'
